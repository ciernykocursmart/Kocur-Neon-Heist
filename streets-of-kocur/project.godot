; Engine configuration file.
; Streets of Kocur - Kocur Studios

config_version=5

[application]

config/name="Streets of Kocur"
config/description="2D side-scrolling beat 'em up: a tough black cat fights the White Crown gang through six streets."
config/version="1.0.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.04, 0.1, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="StreetsOfKocur"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
Game="*res://scripts/autoload/game.gd"
Audio="*res://scripts/autoload/audio_manager.gd"
Transition="*res://scripts/autoload/transition.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.04, 0.1, 1)
