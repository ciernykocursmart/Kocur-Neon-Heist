extends Node
## Audio manager (autoload "Audio").
##
## All audio is original and generated by tools/audio/make_audio.py. This
## node owns the shared players: a pool for 2D one-shots, a pool for 3D
## one-shots, one ambience loop and two music players for crossfades.
## Per-kart engine loops live in RaceAudio and are freed with the race scene.

const SFX := ["engine", "drift", "spark1", "spark2", "boost_small", "boost_big", "boost_purr", "pad", "bump", "wall",
	"land", "jump", "hazard", "count", "go", "lap", "final_lap", "finish", "record", "fanfare", "unlock", "respawn",
	"wrong_way", "ui_move", "ui_select", "ui_back", "ui_pause", "cheer"]
const MUSIC := ["menu", "woods", "pier", "neon", "snow", "safari", "royal"]
const AMBIENCE := ["birds", "sea", "city", "wind", "savanna", "crowd"]
const POOL := 14
const POOL_3D := 12
const MIN_REPEAT := 0.04
const MUSIC_DB := -3.0

var streams := {}
var _pool: Array[AudioStreamPlayer] = []
var _pool3d: Array[AudioStreamPlayer3D] = []
var _pi := 0
var _p3 := 0
var _last := {}
var _music_a: AudioStreamPlayer
var _music_b: AudioStreamPlayer
var _music_name := ""
var _amb: AudioStreamPlayer
var _amb_name := ""


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for n in SFX:
		var s = load("res://assets/audio/sfx/%s.wav" % n)
		if s is AudioStreamWAV and n in ["engine", "drift"]:
			s.loop_mode = AudioStreamWAV.LOOP_FORWARD
			s.loop_begin = 0
			s.loop_end = int(s.get_length() * s.mix_rate)
		if s:
			streams[n] = s
	for n in MUSIC:
		var m = load("res://assets/audio/music/%s.ogg" % n)
		if m:
			m.loop = true
			streams["music_" + n] = m
	for n in AMBIENCE:
		var a = load("res://assets/audio/amb/%s.ogg" % n)
		if a:
			a.loop = true
			streams["amb_" + n] = a
	for i in POOL:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_pool.append(p)
	for i in POOL_3D:
		var p3 := AudioStreamPlayer3D.new()
		p3.bus = "SFX"
		p3.unit_size = 8.0
		p3.max_distance = 90.0
		p3.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
		add_child(p3)
		_pool3d.append(p3)
	_music_a = _music_player()
	_music_b = _music_player()
	_amb = AudioStreamPlayer.new()
	_amb.bus = "SFX"
	_amb.volume_db = -14.0
	add_child(_amb)


func _music_player() -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.bus = "Music"
	p.volume_db = -80.0
	add_child(p)
	return p


func has(name: String) -> bool:
	return streams.has(name)


func _allow(name: String) -> bool:
	if not streams.has(name):
		return false
	var now := Time.get_ticks_msec() / 1000.0
	if now - float(_last.get(name, -1.0)) < MIN_REPEAT:
		return false
	_last[name] = now
	return true


func play(name: String, volume_db := 0.0, pitch := 1.0) -> void:
	if not _allow(name):
		return
	var p := _pool[_pi]
	_pi = (_pi + 1) % _pool.size()
	p.stream = streams[name]
	p.volume_db = volume_db
	p.pitch_scale = maxf(pitch, 0.05)
	p.play()


func play_at(name: String, pos: Vector3, volume_db := 0.0, pitch := 1.0) -> void:
	if not _allow(name + "@3d"):
		return
	if not streams.has(name):
		return
	var p := _pool3d[_p3]
	_p3 = (_p3 + 1) % _pool3d.size()
	p.stream = streams[name]
	p.global_position = pos
	p.volume_db = volume_db
	p.pitch_scale = maxf(pitch, 0.05)
	p.play()


## Crossfades to a music loop; the same track keeps playing uninterrupted.
func play_music(name: String) -> void:
	var key := "music_" + name
	if not streams.has(key):
		return
	if _music_name == name and (_music_a.playing or _music_b.playing):
		return
	_music_name = name
	var incoming := _music_b if _music_a.playing else _music_a
	var outgoing := _music_a if incoming == _music_b else _music_b
	incoming.stream = streams[key]
	incoming.volume_db = -40.0
	incoming.play()
	var tw := create_tween().set_parallel(true)
	tw.tween_property(incoming, "volume_db", MUSIC_DB, 0.8)
	if outgoing.playing:
		tw.tween_property(outgoing, "volume_db", -60.0, 0.8)
		tw.chain().tween_callback(outgoing.stop)


func stop_music() -> void:
	_music_name = ""
	_music_a.stop()
	_music_b.stop()


func current_music() -> String:
	return _music_name


func play_ambience(name: String) -> void:
	var key := "amb_" + name
	if not streams.has(key):
		stop_ambience()
		return
	if _amb_name == name and _amb.playing:
		return
	_amb_name = name
	_amb.stream = streams[key]
	_amb.play()


func stop_ambience() -> void:
	_amb_name = ""
	_amb.stop()


## Called on every scene change: stops race-only loops so nothing piles up.
func stop_all_loops() -> void:
	stop_ambience()
	for p in _pool3d:
		p.stop()


## Number of shared players currently playing (tests check nothing leaks).
func active_players() -> int:
	var n := 0
	for p in _pool:
		if p.playing:
			n += 1
	for p in _pool3d:
		if p.playing:
			n += 1
	return n
